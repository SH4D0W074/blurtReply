# Copy to .env.local. Never commit your API key.
OPENAI_API_KEY=
# Verify model access before enabling calls. This alias uses low reasoning effort.
# https://developers.openai.com/api/docs/models/gpt-6-luna
OPENAI_MODEL=gpt-6-luna
# Live calls remain disabled until you explicitly enable them.
PAIRWISE_LIVE_AI=false
PAIRWISE_MAX_AI_CALLS=20
# One request per analysis action, no automatic retries. Limit is per server process.
# Timeout is capped at 30 seconds; output includes reasoning tokens (hard cap 8,000).
PAIRWISE_AI_TIMEOUT_MS=30000
PAIRWISE_AI_MAX_OUTPUT_TOKENS=6000
# Only the first 8 eligible explanations are sent. Others remain explicitly unclassified.
# Use simple comparison groups for excess responses; repeating unchanged settings does not page through them.
# Can be increased up to 40 before restarting, with corresponding latency/token considerations.
PAIRWISE_AI_MAX_RESPONSES=8
PORT=3000
HOST=127.0.0.1
