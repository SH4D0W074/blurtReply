# Copy to .env.local. Keep keys here, never in the browser or Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Enable only when ready for paid calls. Guided demo never calls providers.
VIVACOACH_LIVE_AI=false
# Hard request caps per server process, counting failed attempts. No automatic retry.
VIVACOACH_MAX_AI_CALLS=60
VIVACOACH_MAX_TRANSCRIPTIONS=12
VIVACOACH_MAX_VOICE_CALLS=30
# ElevenLabs examiner voice: create a key with Text to Speech access.
# https://elevenlabs.io/app/api/api-keys — restart after changing this file.
# Without a key, or in the free demo, use your device's speech voice.
ELEVENLABS_API_KEY=
# Sarah: softer examiner delivery. Replace with another available voice if preferred.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Richer delivery; use eleven_flash_v2_5 for lower latency and cost.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
PORT=3000
VIVACOACH_HOST=127.0.0.1
# VIVACOACH_DB_PATH=.local/vivacoach.sqlite
